# ══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT CONFIGURATION — AI ENGINEER ASSESSMENT
# Copy this file to .env and configure your keys:
# cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Primary LLM: Google Gemini API ───────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Secondary / Fallback LLM: Groq ───────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Active LLM Provider ──────────────────────────────────────────────────────
# Options: "gemini" | "groq" (defaults to gemini if GEMINI_API_KEY is set)
LLM_PROVIDER=gemini

# ── Deepgram ASR (Optional — for real-time WAV audio streaming replay) ────────
# Get key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Server & Application Configuration ───────────────────────────────────────
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Guardrails & Human-in-the-Loop ───────────────────────────────────────────
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true
ENABLE_HITL=false
HITL_FRUSTRATION_THRESHOLD=0.75
HITL_SUM_INSURED_THRESHOLD=2500000
